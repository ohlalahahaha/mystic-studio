# Copy to ~/.config/mystic-studio/.env (or set in your shell). Never commit the real file.
# Google Gemini API key — powers all vision analysis (photo_see, web_review, video_see, recheck)
# and the optional gemini image provider (native "Nano Banana" generation/editing —
# paid API usage billed by Google separately from any chat subscription).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: token required by the HTTP API (mystic-studio-http). If unset, the API is open
# on localhost only — set one before exposing it beyond your machine.
# MYSTIC_STUDIO_TOKEN=

# Z.ai API key — powers the optional glm image provider (hosted GLM-Image,
# text-to-image only, PAID: $0.015/image). Get one at https://z.ai
# Also read from the canonical secret file ~/.config/mystic/.env. Used server-side
# only: it is never logged and never sent to the image download host.
ZAI_API_KEY=
